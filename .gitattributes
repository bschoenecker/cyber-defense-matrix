# Force LF line endings for shell scripts regardless of the platform Git is
# running on. Without this, Windows Git (autocrlf=true) converts them to CRLF
# and the scripts fail inside the Linux Docker container.
* text=auto
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
