# ── Local development only ────────────────────────────────────────────────────
# These variables are used when running `npm run dev` locally.
# For Docker deployment, configure docker-compose.yml instead.

# SQLite database path (local dev — unencrypted)
DATABASE_URL="file:./prisma/data/cdm.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Full public URL of the app
NEXTAUTH_URL="http://localhost:3000"

# ── Docker deployment ─────────────────────────────────────────────────────────
# The following are set in docker-compose.yml, not here.
#
# DB_ENCRYPTION_KEY  — AES-256 key for encrypting the database at rest.
#                      Generate with: openssl rand -base64 32
#                      The encrypted file is stored as ./data/cdm.db.enc
#                      The decrypted runtime copy lives only inside the container.
